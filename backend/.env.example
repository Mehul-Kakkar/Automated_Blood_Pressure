# Copy to .env and set only the values needed for local development.
APP_NAME=Experimental Device API
ENVIRONMENT=development
LOG_LEVEL=INFO
DOCS_ENABLED=true
# Comma-separated exact origins; keep empty to disable browser CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional. Leave empty for a local run without PostgreSQL.
# Example placeholder only; never use real credentials in this template.
DATABASE_URL=
DATABASE_CONNECT_TIMEOUT_SECONDS=2
MAX_TELEMETRY_BATCH_SAMPLES=500
MAX_TELEMETRY_BATCH_BYTES=262144
# MQTT remains disabled until a TLS broker, backend service account and
# per-device broker ACLs are provisioned. Never place secrets in this template.
MQTT_ENABLED=false
MQTT_HOST=
MQTT_PORT=8883
MQTT_CLIENT_ID=bp-backend
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CA_FILE=
# Optional backend client certificate authentication (set both or neither).
MQTT_CLIENT_CERT_FILE=
MQTT_CLIENT_KEY_FILE=
MQTT_QUEUE_SIZE=500
MQTT_MAX_PAYLOAD_BYTES=262144
MQTT_PUBLISH_TIMEOUT_SECONDS=5
MQTT_COMMAND_TTL_SECONDS=30
DEVICE_STATE_MAX_AGE_SECONDS=30
