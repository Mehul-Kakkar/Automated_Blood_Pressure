# Copy to .env and set only the values needed for local development.
APP_NAME=Experimental Device API
ENVIRONMENT=development
LOG_LEVEL=INFO
DOCS_ENABLED=true
# Comma-separated exact origins; keep empty to disable browser CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional. Leave empty for a local run without PostgreSQL.
# Example placeholder only; never use real credentials in this template.
DATABASE_URL=
DATABASE_CONNECT_TIMEOUT_SECONDS=2
MAX_TELEMETRY_BATCH_SAMPLES=500
MAX_TELEMETRY_BATCH_BYTES=262144
# MQTT remains disabled until the broker password and per-device broker ACLs
# are configured in the local root .env. TLS verification is always required.
MQTT_ENABLED=false
# Set true only when the backend MQTT principal's ACL also permits bp/v1 topics.
MQTT_LEGACY_TOPIC_COMPATIBILITY=false
# EMQX Cloud Serverless endpoint; the hostname is retained for TLS SNI.
MQTT_BROKER_HOST=k7128701.ala.asia-southeast1.emqxsl.com
MQTT_BROKER_PORT=8883
MQTT_TLS_ENABLED=true
MQTT_CLIENT_ID=bp_backend_local
MQTT_KEEPALIVE=60
MQTT_USERNAME=bp_backend
MQTT_PASSWORD=
MQTT_CA_CERT_PATH=
# If set, the path is inside the backend container. Put the CA at the same
# relative path under ./certs, which is mounted read-only at /run/mqtt-ca.
# Optional backend client certificate authentication (set both or neither).
MQTT_CLIENT_CERT_FILE=
MQTT_CLIENT_KEY_FILE=
MQTT_QUEUE_SIZE=500
MQTT_MAX_PAYLOAD_BYTES=262144
MQTT_PUBLISH_TIMEOUT_SECONDS=5
MQTT_COMMAND_TTL_SECONDS=30
DEVICE_STATE_MAX_AGE_SECONDS=30
