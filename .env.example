POSTGRES_PASSWORD=replace-with-a-local-postgres-password

# EMQX Cloud MQTT; leave disabled until the backend secret is supplied.
MQTT_ENABLED=false
MQTT_LEGACY_TOPIC_COMPATIBILITY=false
MQTT_BROKER_HOST=k7128701.ala.asia-southeast1.emqxsl.com
MQTT_BROKER_PORT=8883
MQTT_TLS_ENABLED=true
MQTT_USERNAME=bp_backend
MQTT_PASSWORD=
# Empty uses the container's trusted CA bundle. To use a downloaded CA,
# place it at ./certs/emqx-ca.crt and set this to /run/mqtt-ca/emqx-ca.crt.
MQTT_CA_CERT_PATH=
MQTT_CLIENT_ID=bp_backend_local
MQTT_KEEPALIVE=60
